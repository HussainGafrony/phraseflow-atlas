MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/phraseflow-atlas
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_TIME_ZONE=Europe/Bucharest
NEXT_PUBLIC_APP_NAME=PhraseFlow Atlas
# Optional server administrator, alongside database admin accounts.
# Names and passwords are used exactly as entered. Both must be non-empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional explicit database name (otherwise URI database or phraseflow-atlas)
MONGODB_DB_NAME=
