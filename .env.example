MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/phraseflow-atlas
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_TIME_ZONE=Europe/Bucharest
NEXT_PUBLIC_APP_NAME=PhraseFlow Atlas
# Server-only administrator: username 3-40 characters, password 8-120.
# Required for /admin/login; no setup page or database admin is used.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional explicit database name (otherwise URI database or phraseflow-atlas)
MONGODB_DB_NAME=
# Protects the scheduled weekly rotation
CRON_SECRET=
# Optional private Blob token; existing encrypted database settings still work.
BLOB_READ_WRITE_TOKEN=
